# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Klucz service_role: tylko na serwerze (Vercel), nigdy w przeglądarce ani w czacie
SUPABASE_SERVICE_ROLE_KEY=

# Base: Konto i inne → Moje konto → API
BASE_API_TOKEN=

# Shopify: aplikacja z Dev Dashboard zainstalowana w sklepie (Client ID i Secret)
SHOPIFY_TELEFONIKI_CLIENT_ID=
SHOPIFY_TELEFONIKI_CLIENT_SECRET=
SHOPIFY_SNEAKERS_DEPOT_CLIENT_ID=
SHOPIFY_SNEAKERS_DEPOT_CLIENT_SECRET=

# Losowy ciąg (np. 40 znaków) do zabezpieczenia zadań cyklicznych
CRON_SECRET=
