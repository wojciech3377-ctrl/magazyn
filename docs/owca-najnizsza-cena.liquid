{%- comment -%}
  Najniższa cena z 30 dni (Omnibus) pod ceną – zawsze widoczna (bez wartości z aplikacji – obecna cena rozmiaru).
  Wartość zapisuje aplikacja magazynu w metapolu rozmiaru magazyn.lowest_price_30d (z historii cen aplikacji).
  Wklej jako blok „Własny kod Liquid” (Custom Liquid) w sekcji produktu, tuż pod blokiem „Cena”.
{%- endcomment -%}
{%- assign om_v = product.selected_or_first_available_variant -%}
{%- assign om_val = om_v.metafields.magazyn.lowest_price_30d.value -%}
{%- if om_val != blank -%}{%- assign om_cents = om_val | times: 100 | round -%}{%- else -%}{%- assign om_cents = om_v.price -%}{%- endif -%}
<p id="omnibus-{{ section.id }}" class="omnibus-lowest" style="margin:.25rem 0 0;font-size:.85em;opacity:.75">
  {%- if om_v.compare_at_price > om_v.price -%}Najniższa cena z 30 dni przed obniżką: {% else %}Najniższa cena z 30 dni: {% endif -%}
  {{- om_cents | money -}}
</p>
<script type="application/json" id="omnibus-data-{{ section.id }}">
{ {%- for v in product.variants -%}
  {%- assign l = v.metafields.magazyn.lowest_price_30d.value -%}
  {%- if l != blank -%}{%- assign lc = l | times: 100 | round -%}{%- else -%}{%- assign lc = v.price -%}{%- endif -%}
  "{{ v.id }}": { "l": {{ lc | money | json }}, "s": {% if v.compare_at_price > v.price %}true{% else %}false{% endif %} }{% unless forloop.last %},{% endunless %}
{%- endfor -%} }
</script>
<script>
  (function () {
    var box = document.getElementById('omnibus-{{ section.id }}');
    var raw = document.getElementById('omnibus-data-{{ section.id }}');
    if (!box || !raw) return;
    var data = {};
    try { data = JSON.parse(raw.textContent); } catch (e) { return; }
    var scope = box.closest('.shopify-section') || document;
    var last = null;
    function current() {
      var input = scope.querySelector('form[action*="/cart/add"] [name="id"]') || document.querySelector('form[action*="/cart/add"] [name="id"]');
      return (input && input.value) || new URLSearchParams(location.search).get('variant');
    }
    function update() {
      var id = current();
      if (!id || id === last) return;
      last = id;
      var d = data[id];
      if (!d || !d.l) return;
      box.textContent = (d.s ? 'Najniższa cena z 30 dni przed obniżką: ' : 'Najniższa cena z 30 dni: ') + d.l;
    }
    update();
    document.addEventListener('change', function () { setTimeout(update, 50); });
    setInterval(update, 700);
  })();
</script>
